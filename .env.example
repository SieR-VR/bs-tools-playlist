# ===== Coolify 'Secrets' 에 입력할 항목 (값은 저장소에 커밋하지 마세요) =====

# Cloudflare 계정 ID (R2 엔드포인트 주소에 사용)
R2_ACCOUNT_ID=

# R2 API Token 의 Access Key ID
R2_ACCESS_KEY_ID=

# R2 API Token 의 Secret Access Key
R2_SECRET_ACCESS_KEY=

# 업로드 대상 R2 버킷 이름
R2_BUCKET=

# 플레이리스트가 공개되는 URL의 기준 (r2.dev 서브도메인 또는 버킷에 연결한 커스텀 도메인)
# 예: https://pub-xxxxxxxx.r2.dev  또는  https://playlists.example.com
R2_PUBLIC_BASE_URL=

# POST /generate 실행에 필요한 Bearer 토큰 (임의의 긴 문자열)
GENERATE_TOKEN=


# ===== 선택 설정 (일반 환경변수, 기본값으로 두면 됨) =====

# 버킷 내 저장 경로 접두사 (빈 문자열이면 루트에 저장)
# R2_KEY_PREFIX=playlists/

# 다루는 최대 별 구간 (현재 ScoreSaber 랭크맵 최대는 14★, 여유분 16)
# MAX_STAR=16

# true면 플레이리스트 내부를 별 내림차순(어려운→쉬운)으로 정렬
# SORT_DESC=false

# 컨테이너 시작(재배포/재시작) 시 자동으로 1회 생성 실행
# RUN_ON_STARTUP=true

# ScoreSaber API 요청 간격(초). 0.15 = 분당 약 400 요청
# REQUEST_DELAY=0.15

# ScoreSaber API 재시도 횟수
# MAX_RETRIES=6

# ScoreSaber API 요청 타임아웃(초)
# REQUEST_TIMEOUT=30

# ScoreSaber API 기본 URL
# SCORESABER_API_BASE=https://scoresaber.com/api

# ScoreSaber API 에 보낼 User-Agent
# USER_AGENT=bs-playlist-generator/1.0
